# ----------------------------------------------------------------------------
# DealerHub API - Variáveis de ambiente (exemplo)
# Copie este arquivo para .env e ajuste os valores. NUNCA versione o .env real.
# ----------------------------------------------------------------------------

# Ambiente: development | test | production
NODE_ENV=development

# Porta HTTP da API
PORT=3333

# String de conexão do PostgreSQL
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://dealerhub:dealerhub@localhost:5432/dealerhub?schema=public"

# Segredos JWT (use valores longos e aleatórios em produção)
JWT_SECRET="troque-por-um-segredo-forte-de-access-token"
JWT_REFRESH_SECRET="troque-por-um-segredo-forte-de-refresh-token"

# Tempo de expiração dos tokens (formato do jsonwebtoken: 15m, 7d, etc.)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Origem(ns) permitida(s) para CORS. Use * para liberar tudo (apenas dev).
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Nível de log do pino: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
